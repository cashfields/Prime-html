            // Handle button states
//            prevBtn.disabled = currentIndex === 0;
//            nextBtn.disabled = currentIndex === images.length - 1;
        }

        function nextImage() {
            if (currentIndex < images.length - 1) {
                currentIndex++;
                updateDisplay();
            }
                        else
                        {
        // set wrap up
                                                  increment();
                                  currentIndex = 0;

                                  updateDisplay();


                        }
        }

//        function prevImage() {
//            if (currentIndex > 0) {
//                currentIndex--;
//                updateDisplay();
//            }

        function prevImage()
                        {
           if (currentIndex > 0) {
                currentIndex--;
                updateDisplay();
            }
            else

                {
        // set wrap down
                decrement();
                currentIndex = images.length-1;

                                  updateDisplay();


           }

        }

        // Initialize on load
        if (images.length > 0) {
            updateDisplay();
        } else {
            document.getElementById('image-container').innerHTML = '<p>No images found.</p>';
        }
